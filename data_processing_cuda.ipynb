      "File \u001b[0;32m/environment/miniconda3/lib/python3.11/site-packages/sklearn/utils/extmath.py:991\u001b[0m, in \u001b[0;36m_safe_accumulator_op\u001b[0;34m(op, x, *args, **kwargs)\u001b[0m\n\u001b[1;32m    985\u001b[0m     \u001b[38;5;28;01mreturn\u001b[39;00m X\n\u001b[1;32m    988\u001b[0m \u001b[38;5;66;03m# Use at least float64 for the accumulating functions to avoid precision issue\u001b[39;00m\n\u001b[1;32m    989\u001b[0m \u001b[38;5;66;03m# see https://github.com/numpy/numpy/issues/9393. The float64 is also retained\u001b[39;00m\n\u001b[1;32m    990\u001b[0m \u001b[38;5;66;03m# as it is in case the float overflows\u001b[39;00m\n\u001b[0;32m--> 991\u001b[0m \u001b[38;5;28;01mdef\u001b[39;00m \u001b[38;5;21m_safe_accumulator_op\u001b[39m(op, x, \u001b[38;5;241m*\u001b[39margs, \u001b[38;5;241m*\u001b[39m\u001b[38;5;241m*\u001b[39mkwargs):\n\u001b[1;32m    992\u001b[0m \u001b[38;5;250m    \u001b[39m\u001b[38;5;124;03m\"\"\"\u001b[39;00m\n\u001b[1;32m    993\u001b[0m \u001b[38;5;124;03m    This function provides numpy accumulator functions with a float64 dtype\u001b[39;00m\n\u001b[1;32m    994\u001b[0m \u001b[38;5;124;03m    when used on a floating point input. This prevents accumulator overflow on\u001b[39;00m\n\u001b[0;32m   (...)\u001b[0m\n\u001b[1;32m   1012\u001b[0m \u001b[38;5;124;03m        The output of the accumulator function passed to this function.\u001b[39;00m\n\u001b[1;32m   1013\u001b[0m \u001b[38;5;124;03m    \"\"\"\u001b[39;00m\n\u001b[1;32m   1014\u001b[0m     \u001b[38;5;28;01mif\u001b[39;00m np\u001b[38;5;241m.\u001b[39missubdtype(x\u001b[38;5;241m.\u001b[39mdtype, np\u001b[38;5;241m.\u001b[39mfloating) \u001b[38;5;129;01mand\u001b[39;00m x\u001b[38;5;241m.\u001b[39mdtype\u001b[38;5;241m.\u001b[39mitemsize \u001b[38;5;241m<\u001b[39m \u001b[38;5;241m8\u001b[39m:\n",
